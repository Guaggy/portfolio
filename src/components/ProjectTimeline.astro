---
// PROJECT TIMELINE: one line in time, one point per published project at its publish date (frontmatter `date`).
// Labels alternate above and below the line so neighbouring points stay readable.
// Built at build time. Range: first publish date to today (or the latest date), padded by one month, at least 6 months.
import type { Project } from '../lib/projects';

interface Props { projects: Project[] }
const { projects } = Astro.props;

const DAY = 86_400_000;
const items = [...projects].sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const first = items.length ? items[0].data.date.valueOf() : Date.now();
const last = items.length ? items[items.length - 1].data.date.valueOf() : Date.now();

const startDate = new Date(first - 30 * DAY);
const start = new Date(startDate.getFullYear(), startDate.getMonth(), 1);
const endDate = new Date(Math.max(Date.now(), last) + 30 * DAY);
let end = new Date(endDate.getFullYear(), endDate.getMonth() + 1, 1);
if (end.valueOf() - start.valueOf() < 180 * DAY) end = new Date(start.getFullYear(), start.getMonth() + 6, 1);
const span = end.valueOf() - start.valueOf();
const pct = (t: number) => ((t - start.valueOf()) / span) * 100;

// Axis label every three months.
const ticks: { left: number; label: string }[] = [];
for (let d = new Date(start); d < end; d = new Date(d.getFullYear(), d.getMonth() + 3, 1)) {
  ticks.push({ left: pct(d.valueOf()), label: d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }) });
}

const points = items.map((p, i) => ({
  id: p.id,
  title: p.data.title,
  dateText: p.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }),
  left: pct(p.data.date.valueOf()),
  side: i % 2 === 0 ? 'above' : 'below',
  draft: p.data.status === 'draft',
}));
---
<figure class="tl">
  <div class="tl-scroll">
    <div class="tl-track">
      <div class="tl-line"></div>
      {ticks.map((t, i) => <span class={i === 0 ? "tl-tick first" : "tl-tick"} style={`left:${t.left.toFixed(2)}%`}>{t.label}</span>)}
      {points.map((p) => (
        <a class={`tl-point ${p.side}`} href={`/projects/${p.id}/`} style={`left:${p.left.toFixed(2)}%`}>
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-label">
            {p.title}
            <small class="mono">published {p.dateText}{p.draft && ' · draft'}</small>
          </span>
        </a>
      ))}
    </div>
  </div>
  <figcaption class="mono">
    {points.length === 0 ? 'No published projects yet.' : `${points.length} project${points.length === 1 ? '' : 's'} · one point per publish date`}
  </figcaption>
</figure>

<style>
  .tl { margin: 0; }
  .tl-scroll { overflow-x: auto; padding: 8px 0 4px; }
  .tl-track { position: relative; height: 210px; min-width: 620px; margin: 0 24px; }
  .tl-line { position: absolute; left: 0; right: 0; top: 50%; height: 2px; background: var(--line); }
  .tl-tick { position: absolute; top: calc(50% + 8px); transform: translateX(-50%); color: var(--muted); font: 11px "IBM Plex Mono", monospace; white-space: nowrap; }
  .tl-tick.first { transform: none; }
  .tl-point { position: absolute; top: 50%; transform: translate(-50%, -50%); width: 0; text-decoration: none; color: var(--text); }
  .tl-dot { display: block; width: 14px; height: 14px; margin: 0 auto; border-radius: 50%; background: var(--accent); border: 2px solid var(--bg); box-sizing: content-box; }
  .tl-label { position: absolute; left: 50%; transform: translateX(-50%); width: 190px; text-align: center; font-size: 14px; line-height: 1.3; }
  .tl-label small { display: block; margin-top: 2px; font-size: 0.68rem; }
  .tl-point:hover .tl-label, .tl-point:focus-visible .tl-label { color: var(--accent); }
  .tl-point.above .tl-label { bottom: 22px; }
  .tl-point.below .tl-label { top: 22px; }
  .tl figcaption { margin-top: 10px; }
</style>
