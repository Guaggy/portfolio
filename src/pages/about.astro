---
// ABOUT & CONTACT: portrait, short bio, academic facts, project timeline, CV downloads and contact details.
// Text lives in src/site.config.ts > about. Portrait file: src/assets/about/portrait.jpg (replace it, keep the name).
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectTimeline from '../components/ProjectTimeline.astro';
import portrait from '../assets/about/portrait.jpg';
import { siteConfig } from '../site.config';
import { visibleProjects } from '../lib/projects';

const f = siteConfig.features;
const projects = await visibleProjects();
---
<Base current="/about/" title="About" description="About Even Mælum: background, projects, CV and contact details.">
  <section class="about">
    <div class="about-head">
      {f.showPicture && (
        <Image src={portrait} alt={siteConfig.portraitAlt} class="portrait" widths={[400, 800]} sizes="(min-width: 720px) 260px, 70vw" />
      )}
      <div>
        <h1>About</h1>
        <p>{siteConfig.about.bio}</p>
        <p class="mono">{siteConfig.location}</p>

        {f.showAcademic && (
          <dl class="facts">
            <dt>Grade average</dt>
            <dd>{siteConfig.about.academic.grade}</dd>
            <dt>Relevant courses</dt>
            <dd>
              <ul class="courses">
                {siteConfig.about.academic.courses.map((c) => <li>{c}</li>)}
              </ul>
            </dd>
          </dl>
        )}
      </div>
    </div>

    {f.showProjectTimeline && (
      <section id="timeline">
        <h2>Project timeline</h2>
        <ProjectTimeline projects={projects} />
      </section>
    )}

    {f.showCv && (
      <section id="cv">
        <h2>CV</h2>
        <div class="btns">
          <a class="btn primary" href={siteConfig.cv.english} download>Download CV (English)</a>
          <a class="btn" href={siteConfig.cv.norwegian} download>Last ned CV (norsk)</a>
        </div>
      </section>
    )}

    <section id="contact">
      <h2>Contact</h2>
      <ul class="contact-list">
        <li>Email: <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></li>
        {f.showPhone && <li>Phone: <a href={`tel:${siteConfig.phone.replace(/\s/g, '')}`}>{siteConfig.phone}</a></li>}
        {siteConfig.github && <li>GitHub: <a href={siteConfig.github} rel="me">{siteConfig.github.replace('https://', '')}</a></li>}
        {siteConfig.linkedin && <li>LinkedIn: <a href={siteConfig.linkedin} rel="me">{siteConfig.linkedin.replace('https://', '')}</a></li>}
      </ul>
    </section>
  </section>
</Base>
