---
// NOT FOUND: shown for any unknown address.
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="post">
    <p class="mono">Error 404</p>
    <h1>Nothing here.</h1>
    <p class="lead">The page you were looking for does not exist or has moved.</p>
    <p><a class="btn" href="/">Back to home</a></p>
  </section>
</Base>
